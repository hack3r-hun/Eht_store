APP_NAME="EK Yarn Co."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production / Railway: LOG_CHANNEL=stderr, SESSION_DRIVER=file|redis, CACHE_STORE=file|redis, SESSION_ENCRYPT=true
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — start with: docker compose up -d
# Docker root password (optional): MYSQL_ROOT_PASSWORD=rootsecret
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ek_yarn_co
DB_USERNAME=ek_yarn_co
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset on Railway (do NOT set to the word "null")
# false for local HTTP; AppServiceProvider forces true in production HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# "file" needs no extra service to provision and works on shared hosting or a single-server
# VPS alike. Requires a persistent (non-ephemeral) storage path and a single app server —
# for multi-server/high-traffic deployments, switch to "redis" (e.g. Railway's Redis plugin).
CACHE_STORE=file

# Sanctum personal access tokens expire after N minutes (default 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

# Comma-separated browser origins allowed to call /api/* with CORS (e.g. a web SPA).
# Leave empty if only native mobile / server-to-server clients use the API — bearer-token
# clients aren't subject to CORS. Never set to "*".
CORS_ALLOWED_ORIGINS=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Strong passwords for the seeded demo accounts (set real values in production;
# applied on deploy by `php artisan accounts:sync-passwords`)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

SHOP_NAME="EK Yarn Co."
SHOP_TAGLINE="Handcrafted crochet, knitted gifts, and cozy yarn creations"
SHOP_CURRENCY=PKR
SHOP_CURRENCY_SYMBOL="Rs."
SHOP_TAX_RATE=0
SHOP_SHIPPING_FLAT=250
SHOP_CONTACT_EMAIL=hello@ekyarnco.local
SHOP_CONTACT_PHONE="+92 300 1234567"
SHOP_CONTACT_ADDRESS="Karachi, Pakistan"

# Comma-separated IPs/CIDRs of your reverse proxy / load balancer. "*" (default) is fine when the app is
# only reachable through Railway/Cloudflare; restrict it otherwise so X-Forwarded-For cannot be spoofed.
# TRUSTED_PROXIES=*
